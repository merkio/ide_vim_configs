// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && mode == full && VimControl && !menu",
    "bindings": {
      "space space": ["workspace::SendKeystrokes", ":noh\\n"],
      "space f": "file_finder::Toggle",
      "space p": "command_palette::Toggle",
      "space o": "tab_switcher::Toggle",
      "space b": "outline::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space t": "terminal_panel::Toggle",
      "space /": "project_search::ToggleFocus",
      "space r": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      "space s": "workspace::Save",
      "space g d": "editor::GoToDefinition",
      "space g i": "editor::GoToImplementation",
      "space g t": "editor::GoToTypeDefinition",
      "space g r": "editor::FindAllReferences",
      "space h": "workspace::ActivatePaneLeft",
      "space l": "workspace::ActivatePaneRight",
      "space k": "workspace::ActivatePaneUp",
      "space j": "workspace::ActivatePaneDown",
      "space d b": "editor::ToggleBreakpoint",
      "space d c": "debug_panel::ToggleFocus",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
]
